# ─────────────────────────────────────────────────────────────────────────────
# Expert Network Search Copilot — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Source Database (PostgreSQL) ──────────────────────────────────────────────
# Read-only connection to the candidate profiles database
POSTGRES_URL=postgresql://developer:devread2024@34.79.32.228:5432/candidate_profiles

# ── OpenRouter LLM API ────────────────────────────────────────────────────────
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── OpenRouter Model ──────────────────────────────────────────────────────────
# Recommended: anthropic/claude-3-haiku  (fast, cost-effective, smart enough)
# Alternatives: openai/gpt-4o-mini  |  google/gemini-flash-1.5  |  meta-llama/llama-3.1-70b-instruct
OPENROUTER_MODEL=anthropic/claude-3-haiku

# ── Embedding Model ───────────────────────────────────────────────────────────
# Local sentence-transformer model (downloaded automatically on first use, ~90 MB)
# Alternatives: BAAI/bge-small-en-v1.5  |  BAAI/bge-large-en-v1.5  |  multi-qa-MiniLM-L6-cos-v1
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Vector Database (ChromaDB) ────────────────────────────────────────────────
# Path where ChromaDB persists its data on disk
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION_NAME=expert_profiles

# ── Ingestion Settings ────────────────────────────────────────────────────────
# Number of candidates to embed per batch (tune based on available RAM)
INGEST_BATCH_SIZE=100

# ── Search Settings ───────────────────────────────────────────────────────────
# Default number of results returned by /chat
DEFAULT_TOP_K=10
MAX_TOP_K=50

# ── Conversation Settings ─────────────────────────────────────────────────────
# Minutes before an inactive conversation is evicted from memory
CONVERSATION_TTL_MINUTES=60

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=Expert Network Search Copilot
LOG_LEVEL=INFO
ENVIRONMENT=development
